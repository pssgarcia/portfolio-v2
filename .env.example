# Contact form -> Resend (used by api/contact.js)
# Copy to .env for local `vercel dev`; set the same keys in the Vercel dashboard.

# API key from https://resend.com/api-keys (one scoped to this project)
RESEND_API_KEY=

# "From" address on a domain verified in your Resend account
# e.g. Portfolio <contato@your-domain.dev>
CONTACT_FROM=
